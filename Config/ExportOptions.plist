<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	How `make upload` exports the archive (MS-152, docs/runbooks/release.md): signed automatically for Dentory's team
	through the Apple account signed into Xcode, uploaded straight to App Store Connect with its symbols. The version
	and build number stay the ones `make archive` gave the build (MARKETING_VERSION, the commit count).
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>886B9D4D6M</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
