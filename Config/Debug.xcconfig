// Debug builds talk to the local Supabase stack (`make db-start`). These values are the same on every
// machine: the CLI's demo anon key, not a secret. To point a Debug build at a hosted project instead,
// put its values in Secrets.debug.xcconfig (git-ignored); it is included last and wins.
// xcconfig treats "//" as a comment, so the URL scheme is written as http:/$()/
SUPABASE_URL = http:/$()/127.0.0.1:54321
SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

// No crash reporting from Debug builds unless Secrets.debug.xcconfig sets a DSN.
SENTRY_DSN =

#include? "Secrets.debug.xcconfig"
