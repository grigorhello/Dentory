-- MS-150 · One bottle opened from its product's page in the load-test clinic, as `make perf-concurrency` runs it
-- (concurrency.sh): a random member opens a new bottle of one of the multi-use products the procedures open too, in a
-- transaction of its own with the member's claims, as PostgREST runs it.
\set member random(1, 5)
\set pick random(0, 999999)
begin;
select set_config('request.jwt.claims', json_build_object(
  'sub', ('10ad0000-0000-4000-8000-0001' || lpad(:member::text, 8, '0'))::uuid, 'role', 'authenticated'
)::text, true);
select set_config('role', 'authenticated', true);
select public.bottle_open(b.id, gen_random_uuid())
from (
  select p.id, row_number() over (order by p.id) - 1 as n, count(*) over () as products
  from public.products p
  where p.clinic_id = '10ad0000-0000-4000-8000-000000000001' and p.tracking = 'multi_use' and p.archived_at is null
    and exists (select 1 from public.procedure_template_items i where i.product_id = p.id)
) b
where b.n = :pick % b.products;
commit;
