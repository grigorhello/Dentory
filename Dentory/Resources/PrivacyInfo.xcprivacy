<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	The app's privacy manifest (MS-152). The collected data types are the App Privacy label of
	docs/handoff/app-store-connect.md, step 3, row for row: change the two together. The required-reason APIs are the
	ones Dentory.app/Dentory calls, the code of the packages linked into it included (PostHog and Sentry are static):
	user defaults, file timestamps and system boot time, with the reasons of the decisions log (2026-11-05). A change
	that calls another one adds it here (docs/runbooks/release.md, "After a release").
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
